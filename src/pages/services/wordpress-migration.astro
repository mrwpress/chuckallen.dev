---
import Layout from '../../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import GridBackground from '../../shared/components/GridBackground.astro';
import BadgeWheel from '../../shared/components/BadgeWheel.astro';
import Contact from '../../shared/components/Contact.astro';
import { site } from '../../config/site';
import { yearsExperience } from '../../shared/utils/config';
import { serviceSchema } from '../../shared/utils/schema';
import GoogleReviewBadge from '../../components/GoogleReviewBadge.astro';
import Testimonials from '../../components/Testimonials.astro';

const years = yearsExperience(site);
const pageUrl = new URL('/services/wordpress-migration/', site.url).href;

const schema = serviceSchema({
  name: 'WordPress Migration to Static Architecture',
  description: 'Migrate your WordPress site to a modern static architecture. Faster load times, $0/month hosting, zero maintenance, no security vulnerabilities.',
  url: pageUrl,
  site,
});

const badgeItems = [
  { label: 'WordPress Migration', icon: '/images/badge-wp-migration.svg' },
  { label: 'Under 1 Second Load', icon: '/images/badge-zap.svg' },
  { label: '$0/Month Hosting', icon: '/images/badge-piggybank.svg' },
  { label: 'Zero Maintenance', icon: '/images/badge-wrench-off.svg' },
  { label: 'No Security Patches', icon: '/images/badge-shield-check.svg' },
  { label: 'You Own Everything', icon: '/images/badge-key.svg' },
];

import gearlinxLogo from '../../assets/images/clients/gearlinx-logo.png';
import alinkLogo from '../../assets/images/clients/alink-logo.avif';
import csodLogo from '../../assets/images/clients/csod-logo.png';
import blbtLogo from '../../assets/images/clients/blbt-logo.png';

const clients = [
  {
    name: 'Gearlinx',
    logo: gearlinxLogo,
    logoInvert: false,
    url: 'https://gearlinx.com',
    type: 'IoT & Network Infrastructure',
    metrics: [
      { label: 'Monthly cost', before: '$149/mo', after: '$0/mo' },
      { label: 'Page load', before: '4.1s', after: '0.6s' },
      { label: 'PageSpeed', before: '42', after: '97' },
    ],
    quote: 'We went from a sluggish WordPress site to something our sales team actually wants to share with prospects.',
    timeline: 'Built in 12 days',
  },
  {
    name: 'Alink CIS',
    logo: alinkLogo,
    logoInvert: false,
    url: 'https://www.alinkcis.com',
    type: 'Commercial IT Services',
    metrics: [
      { label: 'Monthly cost', before: '$129/mo', after: '$0/mo' },
      { label: 'Page load', before: '3.8s', after: '0.4s' },
      { label: 'PageSpeed', before: '48', after: '99' },
    ],
    quote: 'No more plugin updates, no more security scares. The site just works and we never think about it.',
    timeline: 'Built in 14 days',
  },
  {
    name: 'Chiropractic Solutions of Denver',
    logo: csodLogo,
    logoInvert: false,
    url: 'https://www.chiropracticsolutionsofdenver.com',
    type: 'Healthcare & Chiropractic',
    metrics: [
      { label: 'Monthly cost', before: '$99/mo', after: '$0/mo' },
      { label: 'Page load', before: '3.2s', after: '0.3s' },
      { label: 'PageSpeed', before: '55', after: '98' },
    ],
    quote: 'Patients find us faster now. The site loads instantly and we stopped paying $99 a month for hosting we didn\'t need.',
    timeline: 'Built in 8 days',
  },
  {
    name: 'Better Lives Building Tribes',
    logo: blbtLogo,
    logoInvert: true,
    url: 'https://betterlivesbuildingtribes.com',
    type: 'Coaching & Community',
    metrics: [
      { label: 'Monthly cost', before: '$109/mo', after: '$0/mo' },
      { label: 'Page load', before: '3.6s', after: '0.5s' },
      { label: 'PageSpeed', before: '46', after: '97' },
    ],
    quote: 'We found a break even on our site after just 9 months of leaving expensive hosting behind. Money in our pocket ever since.',
    timeline: 'Built in 11 days',
  },
];
---

<Layout
  title="WordPress Migration — $0/Month Hosting, Sub-Second Loads | Chuck Allen"
  description={`Migrate your WordPress site to modern static architecture. 4 Denver businesses migrated: $0/month hosting, sub-second loads, PageSpeed 97-99. ${years}+ years experience.`}
  extraSchemas={[schema]}
>
  <!-- Hero -->
  <section class="hero">
    <GridBackground />
    <div class="hero-inner section-container">
      <div class="hero-row">
        <div class="hero-content">
          <p class="hero-eyebrow">WordPress Migration</p>
          <h1 class="hero-title">Your WordPress site is costing you<br /><span class="hero-accent">more than you think.</span></h1>
          <p class="hero-sub">
            Between the hosting bills, the plugin updates, the security patches, and the loading times
            that drive visitors away — you're paying for a system that was designed for blogging in 2003.
            I migrate WordPress sites to modern static architecture that loads in under a second, costs
            $0/month to host, and can't be hacked.
          </p>
          <ul class="hero-points">
            <li><span class="hero-icon" aria-hidden="true">⚡</span>Sub-second load times</li>
            <li><span class="hero-icon" aria-hidden="true">💸</span>$0/month hosting</li>
            <li><span class="hero-icon" aria-hidden="true">🔒</span>No security patches</li>
            <li><span class="hero-icon" aria-hidden="true">🧩</span>No plugin updates</li>
            <li><span class="hero-icon" aria-hidden="true">🔑</span>You own everything</li>
            <li><span class="hero-icon" aria-hidden="true">📅</span>Live in 10-14 days</li>
          </ul>
          <div class="hero-actions">
            <a href={site.calendly} target="_blank" rel="noopener" class="btn-primary">Book a Free Strategy Call</a>
            <a href="#proof" class="btn-outline">See Migration Results</a>
            <GoogleReviewBadge />
          </div>
        </div>
        <div class="hero-wheel">
          <BadgeWheel items={badgeItems} checkmarkIcon="/images/badge-checkmark.svg" />
        </div>
      </div>
    </div>
    <div class="hero-marquee-mobile">
      <BadgeWheel items={badgeItems} />
    </div>
  </section>

  <!-- Pain Points -->
  <section class="section">
    <div class="section-container">
      <h2 class="section-title">Sound Familiar?</h2>
      <p class="section-subtitle">
        WordPress worked fine when you set it up. But somewhere along the way, maintaining it became a second job.
      </p>
      <div class="card-grid">
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">💸</span> Hosting bills that never stop</h3>
          <p class="card-desc">$20-100+/month for shared hosting. Managed WordPress hosting is even more. The meter never stops running — and you're not even sure what you're paying for.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">🎰</span> Plugin update anxiety</h3>
          <p class="card-desc">Every update is a gamble. Will it break the site? Will it conflict with another plugin? Do you just... not update and hope nothing goes wrong?</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">🛡️</span> Security scares</h3>
          <p class="card-desc">834,000+ vulnerabilities tracked in WordPress's ecosystem in 2025. You're one outdated plugin away from a defacement or data breach.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">🐌</span> Slow loads losing customers</h3>
          <p class="card-desc">3-5 second loads are normal for WordPress. 53% of mobile visitors leave if a page takes more than 3 seconds. Google measures this. Your visitors measure this.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">👻</span> The developer you can't reach</h3>
          <p class="card-desc">The person who set up your WordPress site is gone, or charges $150/hr for every small change. You're locked into a dependency you never agreed to.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="card-icon" aria-hidden="true">🔧</span> Maintenance you didn't sign up for</h3>
          <p class="card-desc">PHP updates, theme updates, database optimization, backup management. You started a business, not an IT department.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- What Migration Looks Like -->
  <section id="what-migration-looks-like" class="section">
    <GridBackground blobColor="rgba(220,38,38,0.04)" />
    <div class="section-container">
      <h2 class="section-title">What Your Migrated Site Looks Like</h2>
      <p class="section-subtitle">
        Same design. Same content. Radically better performance — and nothing left to maintain.
      </p>
      <div class="card-grid">
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> Sub-second load times</h3>
          <p class="card-desc">Your pages load in under a second. Not because of a caching plugin — because there's no server processing, no database queries, no bloat.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> $0/month to run</h3>
          <p class="card-desc">No hosting fees, no maintenance plans, no premium plugins. Pre-built HTML served from a global CDN. The hosting tier that covers it is free — permanently.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> No security vulnerabilities</h3>
          <p class="card-desc">No database to inject. No plugins to exploit. No admin login to brute-force. The attack surface disappears entirely.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> You own everything</h3>
          <p class="card-desc">Code, design, domain, hosting account. No vendor lock-in, no proprietary themes, no "you lose everything if you cancel."</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> Content you can still edit</h3>
          <p class="card-desc">Built-in CMS with the same edit experience. Change text, images, pages — without WordPress overhead.</p>
        </div>
        <div class="card-item card">
          <h3 class="card-header"><span class="check-icon" aria-hidden="true">&#10003;</span> PageSpeed scores of 95-100</h3>
          <p class="card-desc">Every site I migrate passes all three Core Web Vitals. Google's ranking signals directly reward this. Only 48% of WordPress sites pass.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section id="proof" class="section proof-section">
    <div class="section-container">
      <h2 class="section-title proof-title">Denver Businesses I've Migrated</h2>
      <p class="section-subtitle proof-subtitle">Real WordPress sites migrated to static architecture. Real metrics, before and after.</p>

      <div class="proof-grid">
        {clients.map((client) => (
          <div class="proof-card card">
            <div class="proof-left">
              <div class="proof-logo-wrap">
                <Picture
                  src={client.logo}
                  alt={`${client.name} logo`}
                  widths={[200, 300]}
                  formats={['avif', 'webp']}
                  class={`proof-logo ${client.logoInvert ? 'invert' : ''}`}
                />
              </div>
              <p class="proof-type">{client.type}</p>
              <p class="proof-quote">{client.quote}</p>
              <div class="proof-metrics">
                {client.metrics.map((m) => (
                  <div class="proof-row">
                    <span class="proof-label">{m.label}</span>
                    <span class="proof-before">{m.before}</span>
                    <span class="proof-arrow" aria-hidden="true">&rarr;</span>
                    <span class="proof-after">{m.after}</span>
                  </div>
                ))}
              </div>
              <p class="proof-footer">
                <span class="proof-timeline">{client.timeline}</span>
                <span class="proof-pipe">|</span>
                <a href={client.url} target="_blank" rel="noopener noreferrer" class="proof-link">Visit Site &rarr;</a>
              </p>
            </div>
            <div class="proof-right">
              <div class="psi-badge" aria-label={`PageSpeed score ${client.metrics[2]?.after}`}>
                <svg class="psi-ring" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="8" />
                  <circle cx="60" cy="60" r="52" fill="none" stroke="#22c55e" stroke-width="8" stroke-linecap="round" stroke-dasharray="327" stroke-dashoffset={`${327 - (327 * Number(client.metrics[2]?.after || 98)) / 100}`} transform="rotate(-90 60 60)" />
                </svg>
                <div class="psi-inner">
                  <span class="psi-score">{client.metrics[2]?.after}</span>
                  <span class="psi-label">PageSpeed</span>
                </div>
              </div>
              <div class="speed-stat">
                <span class="speed-value">{client.metrics[1]?.after}</span>
                <span class="speed-label">load time</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="section-container cta-band-inner">
      <p class="cta-band-headline">Your site could be next. <span class="cta-band-accent">Same results, same timeline.</span></p>
      <p class="cta-band-sub">Free 30-minute call. I'll audit your WordPress site and show you exactly what migration looks like.</p>
      <a href={site.calendly} target="_blank" rel="noopener" class="btn-primary cta-band-btn">Book a Free Strategy Call</a>
    </div>
  </section>

  <!-- Comparison Table -->
  <section class="section compare-section">
    <div class="section-container">
      <h2 class="section-title compare-title">WordPress vs. What You Get After Migration</h2>
      <p class="section-subtitle compare-subtitle">WordPress powers 43% of the web. That doesn't mean it's the best choice for your business.</p>

      <div class="compare-table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th></th>
              <th class="col-wp">WordPress</th>
              <th class="col-my">After Migration</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-label">Mobile PageSpeed</td>
              <td class="col-wp"><span class="cmp-bad">48% pass</span> Core Web Vitals</td>
              <td class="col-my"><span class="cmp-good">100% pass</span> — every site I migrate</td>
            </tr>
            <tr>
              <td class="row-label">Page Load</td>
              <td class="col-wp"><span class="cmp-bad">3-5 seconds</span></td>
              <td class="col-my"><span class="cmp-good">Under 1 second</span></td>
            </tr>
            <tr>
              <td class="row-label">Page Weight</td>
              <td class="col-wp"><span class="cmp-bad">3-5 MB</span> (theme + plugin bloat)</td>
              <td class="col-my"><span class="cmp-good">~500 KB</span></td>
            </tr>
            <tr>
              <td class="row-label">W3C Validation</td>
              <td class="col-wp"><span class="cmp-bad">50-100+ errors</span> typical</td>
              <td class="col-my"><span class="cmp-good">0 errors, 0 warnings</span></td>
            </tr>
            <tr>
              <td class="row-label">Monthly Hosting</td>
              <td class="col-wp"><span class="cmp-bad">$20-$100+/mo</span></td>
              <td class="col-my"><span class="cmp-good">$0/month</span></td>
            </tr>
            <tr>
              <td class="row-label">Maintenance</td>
              <td class="col-wp"><span class="cmp-bad">$50-$350/mo</span> (plans, plugins, updates)</td>
              <td class="col-my"><span class="cmp-good">$0/month</span> — nothing to maintain</td>
            </tr>
            <tr>
              <td class="row-label">Security</td>
              <td class="col-wp"><span class="cmp-bad">834K+ vulnerabilities</span> in 2025</td>
              <td class="col-my"><span class="cmp-good">No attack surface</span> — no database, no plugins</td>
            </tr>
            <tr>
              <td class="row-label">Plugin Conflicts</td>
              <td class="col-wp"><span class="cmp-bad">Routine after updates</span></td>
              <td class="col-my"><span class="cmp-good">No plugins</span> — no conflicts</td>
            </tr>
            <tr>
              <td class="row-label">Traffic Spikes</td>
              <td class="col-wp"><span class="cmp-warn">Server bottleneck</span></td>
              <td class="col-my"><span class="cmp-good">Global CDN</span> — 330+ locations</td>
            </tr>
            <tr>
              <td class="row-label">Rollback</td>
              <td class="col-wp"><span class="cmp-warn">Manual backups</span></td>
              <td class="col-my"><span class="cmp-good">Instant</span> — full version history</td>
            </tr>
            <tr>
              <td class="row-label">Content Editing</td>
              <td class="col-wp">WordPress admin</td>
              <td class="col-my">Built-in CMS — same experience, no overhead</td>
            </tr>
            <tr>
              <td class="row-label">Ownership</td>
              <td class="col-wp"><span class="cmp-warn">Tied to hosting + plugins</span></td>
              <td class="col-my"><span class="cmp-good">You own everything</span> — files, accounts, domain</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="compare-footnote">Core Web Vitals data from Chrome UX Report. WordPress vulnerability count from WPScan 2025 annual report.</p>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band">
    <div class="section-container cta-band-inner">
      <p class="cta-band-headline">Stop paying monthly for a problem <span class="cta-band-accent">you can solve once.</span></p>
      <p class="cta-band-sub">One fixed price. No hosting bills, no maintenance fees, no surprises — ever again.</p>
      <a href={site.calendly} target="_blank" rel="noopener" class="btn-primary cta-band-btn">Get a Free Quote</a>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section">
    <div class="section-container">
      <h2 class="section-title">How It Works</h2>
      <p class="section-subtitle">
        Most migrations take 10-14 days. Here's the process from start to finish.
      </p>
      <div class="steps-row">
        <div class="step-card card">
          <h3 class="step-header"><span class="step-num">1</span> Show me your WordPress site</h3>
          <p class="step-desc">Free strategy call. I'll audit your current site — load times, PageSpeed score, hosting costs, plugin dependencies — and tell you exactly what the migration looks like.</p>
        </div>
        <div class="step-card card">
          <h3 class="step-header"><span class="step-num">2</span> I rebuild it on modern architecture</h3>
          <p class="step-desc">Same design, same content, radically better performance. You review everything before launch. Most migrations take 10-14 days.</p>
        </div>
        <div class="step-card card">
          <h3 class="step-header"><span class="step-num">3</span> Go live with zero monthly costs</h3>
          <p class="step-desc">DNS switch, old hosting canceled, $0/month from here on out. You own every file, every account. Post-migration support included.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- Contact -->
  <Contact
    site={site}
    title='Your website should be costing you <span class="text-accent">$0/month.</span>'
    subtitle="Book a free 30-minute call. I'll audit your current WordPress site and show you exactly what the migration looks like — timeline, cost, and what changes."
  />
</Layout>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 5.5rem 0 1.5rem;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero { padding: 8rem 0 1.5rem; }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .hero-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 3.75rem;
    }
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-wheel {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-wheel {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }
  }

  .hero-marquee-mobile {
    position: relative;
    z-index: 1;
    margin-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .hero-marquee-mobile { display: none; }
  }

  .hero-eyebrow {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-accent-light);
    margin-bottom: 0.625rem;
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 3rem; }
  }
  @media (min-width: 1024px) {
    .hero-title { font-size: 4rem; }
  }

  .hero-accent {
    color: var(--color-accent-light);
  }

  .hero-sub {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    max-width: 560px;
  }
  @media (min-width: 768px) {
    .hero-sub { font-size: 1.125rem; }
  }

  .hero-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-points { gap: 1rem 2.5rem; }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-points { grid-template-columns: repeat(3, 1fr); }
  }

  .hero-points li {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  @media (min-width: 768px) {
    .hero-points li { font-size: 1.125rem; }
  }

  .hero-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* ── Sections ── */
  .section {
    position: relative;
    padding: 3rem 0;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .section { padding: 4.5rem 0; }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    .section-title { font-size: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .section-title { font-size: 3rem; }
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    max-width: 600px;
    margin-bottom: 2rem;
    line-height: 1.7;
  }
  @media (min-width: 768px) {
    .section-subtitle {
      font-size: 1.125rem;
      margin-bottom: 3rem;
    }
  }

  /* ── Card Grid ── */
  .card-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .card-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .card-item {
    padding: 1.25rem;
    transition: border-color 0.2s ease;
  }
  @media (min-width: 768px) {
