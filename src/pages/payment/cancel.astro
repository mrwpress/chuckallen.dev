---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../config/site';
---

<Layout
  title="Payment Cancelled — Chuck Allen"
  description="Your payment was cancelled. No charges were made."
  noindex={true}
>
  <section class="payment-page">
    <div class="section-container">
      <div class="payment-card">
        <div class="cancel-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        </div>
        <h1>Payment Cancelled</h1>
        <p>No charges were made. If you'd like to try again, use the payment link from your invoice.</p>
        <p class="note">Questions? Reach out at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .payment-page {
    padding: 8rem 0 4rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  .payment-card {
    text-align: center;
    max-width: 480px;
    margin: 0 auto;
  }

  .cancel-icon {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
  }

  .payment-card h1 {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .payment-card p {
    color: var(--color-text-muted);
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  .payment-card .note {
    font-size: 0.875rem;
    margin-top: 1.5rem;
  }

  .payment-card a {
    color: var(--color-accent);
  }
</style>
