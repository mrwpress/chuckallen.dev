---
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';

const sections = [
  {
    title: 'Main',
    pages: [
      { name: 'Home', href: '/' },
      { name: 'About', href: '/about/' },
    ],
  },
  {
    title: 'Services',
    pages: [
      { name: 'Website Design & Development', href: '/services/website-design/' },
      { name: 'WordPress Migration', href: '/services/wordpress-migration/' },
      { name: 'Workflow Automation', href: '/services/automation/' },
      { name: 'Third-Party API Integration', href: '/services/api-integrations/' },
      { name: 'Custom Dashboard Development', href: '/services/custom-dashboards/' },
      { name: 'Data Visualization & Dashboards', href: '/services/data-visualization/' },
      { name: 'Project Rescue & Code Recovery', href: '/services/rescue-projects/' },
      { name: 'Serverless & Edge Deployment', href: '/services/serverless-architecture/' },
    ],
  },
  {
    title: 'Legal',
    pages: [
      { name: 'Privacy Policy', href: '/privacy/' },
      { name: 'Terms & Conditions', href: '/terms/' },
    ],
  },
];
---

<Layout
  title="Sitemap — Chuck Allen"
  description="Complete list of pages on chuckallen.dev. Find services, legal pages, and more."
>
  <section class="sitemap-page">
    <div class="section-container">
      <h1 class="sitemap-title">Sitemap</h1>
      <p class="sitemap-subtitle">All pages on {site.legalName}</p>

      <div class="sitemap-grid">
        {sections.map((section) => (
          <div class="sitemap-group">
            <h2 class="group-title">{section.title}</h2>
            <ul class="group-list">
              {section.pages.map((page) => (
                <li>
                  <a href={page.href} class="group-link">{page.name}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .sitemap-page {
    padding: 5.5rem 0 3rem;
  }
  @media (min-width: 768px) {
    .sitemap-page { padding: 8rem 0 4.5rem; }
  }

  .sitemap-title {
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.5rem;
  }
  @media (min-width: 768px) {
    .sitemap-title { font-size: 3rem; }
  }

  .sitemap-subtitle {
    font-size: 1rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .sitemap-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .sitemap-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  .group-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .group-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .group-link {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .group-link:hover {
    color: var(--color-accent-light);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
