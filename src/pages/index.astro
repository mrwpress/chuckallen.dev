---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import GridBackground from '../shared/components/GridBackground.astro';
import BadgeWheel from '../shared/components/BadgeWheel.astro';
import Contact from '../shared/components/Contact.astro';
import { site } from '../config/site';
import { yearsExperience } from '../shared/utils/config';
import GoogleReviewBadge from '../components/GoogleReviewBadge.astro';
import Testimonials from '../components/Testimonials.astro';

import gearlinxLogo from '../assets/images/clients/gearlinx-logo.png';
import alinkLogo from '../assets/images/clients/alink-logo.avif';
import csodLogo from '../assets/images/clients/csod-logo.png';
import blbtLogo from '../assets/images/clients/blbt-logo.png';

const clients = [
  {
    name: 'Gearlinx',
    logo: gearlinxLogo,
    logoInvert: false,
    url: 'https://gearlinx.com',
    type: 'IoT & Network Infrastructure',
    metrics: [
      { label: 'Monthly cost', before: '$149/mo', after: '$0/mo' },
      { label: 'Maintenance', before: '6 hrs/mo', after: '0 hrs/mo' },
      { label: 'Core Web Vitals', before: '1/3', after: '3/3' },
    ],
    psiScore: 97,
    loadTime: '0.6s',
    quote: 'We went from a sluggish WordPress site to something our sales team actually wants to share with prospects.',
    timeline: 'Built in 12 days',
  },
  {
    name: 'Alink CIS',
    logo: alinkLogo,
    logoInvert: false,
    url: 'https://www.alinkcis.com',
    type: 'Commercial IT Services',
    metrics: [
      { label: 'Monthly cost', before: '$129/mo', after: '$0/mo' },
      { label: 'Maintenance', before: '4 hrs/mo', after: '0 hrs/mo' },
      { label: 'Core Web Vitals', before: '1/3', after: '3/3' },
    ],
    psiScore: 99,
    loadTime: '0.4s',
    quote: 'No more plugin updates, no more security scares. The site just works and we never think about it.',
    timeline: 'Built in 14 days',
  },
  {
    name: 'Chiropractic Solutions of Denver',
    logo: csodLogo,
    logoInvert: false,
    url: 'https://www.chiropracticsolutionsofdenver.com',
    type: 'Healthcare & Chiropractic',
    metrics: [
      { label: 'Monthly cost', before: '$99/mo', after: '$0/mo' },
      { label: 'Maintenance', before: '3 hrs/mo', after: '0 hrs/mo' },
      { label: 'Core Web Vitals', before: '0/3', after: '3/3' },
    ],
    psiScore: 98,
    loadTime: '0.5s',
    quote: 'Patients find us faster now. The site loads instantly and we stopped paying $99 a month for hosting we didn\'t need.',
    timeline: 'Built in 8 days',
  },
  {
    name: 'Better Lives Building Tribes',
    logo: blbtLogo,
    logoInvert: true,
    url: 'https://betterlivesbuildingtribes.com',
    type: 'Coaching & Community',
    metrics: [
      { label: 'Monthly cost', before: '$109/mo', after: '$0/mo' },
      { label: 'Maintenance', before: '5 hrs/mo', after: '0 hrs/mo' },
      { label: 'Core Web Vitals', before: '1/3', after: '3/3' },
    ],
    psiScore: 97,
    loadTime: '0.5s',
    quote: 'We found a break even on our site after just 9 months of leaving expensive hosting behind. Money in our pocket ever since.',
    timeline: 'Built in 11 days',
  },
];

const years = yearsExperience(site);

const badgeItems = [
  { label: 'Astro', icon: '/images/badge-performance.svg' },
  { label: 'Next.js', icon: '/images/badge-react.svg' },
  { label: 'Data Visualization', icon: '/images/badge-dataviz.svg' },
  { label: 'Automation', icon: '/images/badge-automation.svg' },
  { label: 'API Integrations', icon: '/images/badge-api.svg' },
  { label: 'Vue & React', icon: '/images/badge-react.svg' },
  { label: 'Serverless Architecture', icon: '/images/badge-security.svg' },
];
---

<Layout>
  <!-- Hero -->
  <section id="hero" class="hero">
    <GridBackground />
    <div class="hero-inner section-container">
      <div class="hero-row">
        <div class="hero-content">
          <h1 class="hero-title">Your project deserves</h1>
          <p class="hero-rotating">
            <span class="rotating-word"><span class="rw-text"></span></span>
          </p>
          <ul class="hero-points">
            <li><span class="hero-icon" aria-hidden="true">🪳</span>Clean, bug-free code</li>
            <li><svg class="hero-icon hero-icon-speed" viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="20" cy="20" r="17" stroke="#1e3a1e" stroke-width="3"/><circle cx="20" cy="20" r="17" stroke="#0cce6b" stroke-width="3" stroke-dasharray="106.8" stroke-dashoffset="0" stroke-linecap="round" transform="rotate(-90 20 20)"/><text x="20" y="24" text-anchor="middle" fill="#0cce6b" font-size="13" font-weight="700">100</text></svg>Speed that converts</li>
            <li><span class="hero-icon" aria-hidden="true">🤖</span>Less manual, more automated</li>
            <li><span class="hero-icon" aria-hidden="true">🪨</span>Stability you can count on</li>
            <li><span class="hero-icon" aria-hidden="true">👻</span>A developer who doesn't ghost</li>
            <li><span class="hero-icon" aria-hidden="true">⚙️</span>Architecture that scales</li>
          </ul>
          <p class="hero-closer">{years}+ years solving exactly these problems — and I stick around to make sure they stay solved.</p>
          <div class="hero-actions">
            <a href="/#contact" class="btn-primary">Get Started</a>
            <a href="/#services" class="btn-outline">See How I Help</a>
            <GoogleReviewBadge />
          </div>
        </div>
        <div class="hero-wheel">
          <BadgeWheel items={badgeItems} checkmarkIcon="/images/badge-checkmark.svg" />
        </div>
      </div>
    </div>
    <!-- Mobile marquee (BadgeWheel hides desktop version internally, but we need a second instance outside the hidden wrapper) -->
    <div class="hero-marquee-mobile">
      <BadgeWheel items={badgeItems} />
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="section">
    <div class="section-container">
      <h2 class="section-title">You Know Something's Not Working</h2>
      <p class="section-subtitle">
        Maybe it's the site that takes forever to load. The reports your team builds by hand every week. The integrations that break every time a vendor updates their API. Here's how I fix that.
      </p>
      <div class="services-grid">
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 6v6l4 2"/><circle cx="12" cy="12" r="10"/><path d="M16 3.13a4 4 0 0 1 0 17.74M8 3.13a4 4 0 0 0 0 17.74"/></svg>
          <h3 class="service-name">Automation That Gives You Hours Back</h3>
          <ul class="service-list">
            <li>Eliminate repetitive manual work costing you money</li>
            <li>Workflows, scheduled tasks, and real-time alerts</li>
            <li>Reclaim your team's time and raise productivity</li>
          </ul>
        </div>
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><path d="M7 16l4-8 4 5 5-9"/></svg>
          <h3 class="service-name">Data You Can Actually See</h3>
          <ul class="service-list">
            <li>Clean data pipelines from scattered sources</li>
            <li>Visualizations that drive decisions</li>
            <li>Stop building reports by hand every week</li>
          </ul>
        </div>
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="18" rx="2"/><circle cx="5" cy="5.5" r="0.5" fill="currentColor"/><circle cx="7.5" cy="5.5" r="0.5" fill="currentColor"/><circle cx="10" cy="5.5" r="0.5" fill="currentColor"/><line x1="2" y1="7.5" x2="22" y2="7.5"/><rect x="4.5" y="10" width="5" height="4" rx="0.5"/><line x1="12" y1="10" x2="19.5" y2="10"/><line x1="12" y1="12" x2="17" y2="12"/><line x1="4.5" y1="16.5" x2="12" y2="16.5"/><line x1="4.5" y1="18.5" x2="10" y2="18.5"/><rect x="15" y="15" width="4.5" height="4" rx="0.5"/></svg>
          <h3 class="service-name">Custom Dashboards</h3>
          <ul class="service-list">
            <li>Custom-built for how your team works</li>
            <li>Real-time metrics, role-based views</li>
            <li>Zero learning curve</li>
          </ul>
        </div>
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          <h3 class="service-name">Integrations That Don't Break</h3>
          <ul class="service-list">
            <li>Payment gateways, CRMs, ERPs, custom connectors</li>
            <li>Error handling and monitoring built in</li>
            <li>No more silent failures</li>
          </ul>
        </div>
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="M7 8h2m2 0h4"/><path d="M7 12h8"/></svg>
          <h3 class="service-name">Web Apps That Work Like Software</h3>
          <ul class="service-list">
            <li>Portals, calculators, intake systems, booking flows</li>
            <li>Solve specific problems, run anywhere</li>
            <li>Custom tools your team uses daily</li>
          </ul>
        </div>
        <div class="service-card card">
          <svg class="service-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          <h3 class="service-name">Websites That Perform From Day One</h3>
          <ul class="service-list">
            <li>Sub-second loads, 95+ PageSpeed scores</li>
            <li>Astro, Next.js, modern frameworks</li>
            <li>$0/month hosting, fixed pricing</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Hook CTA -->
  <section class="hook-cta">
    <div class="section-container hook-cta-inner">
      <p class="hook-cta-headline">Stop paying for problems. <span class="hook-cta-accent">Start solving them.</span></p>
      <p class="hook-cta-sub">Tell me what's broken. I'll tell you exactly how I'd fix it — no pitch, no pressure.</p>
      <a href="#contact" class="btn-primary hook-cta-btn">Let's Talk</a>
    </div>
  </section>

  <!-- Work / Portfolio -->
  <section id="work" class="section">
    <GridBackground blobColor="rgba(0,118,157,0.05)" />
    <div class="section-container">
      <h2 class="section-title">Sites I've Built</h2>
      <p class="section-subtitle">Real businesses running on clean, modern and stable architecture.</p>

      <div class="proof-grid">
        {clients.map((client) => (
          <div class="proof-card card">
            <div class="proof-left">
              <div class="proof-logo-wrap">
                <Picture
                  src={client.logo}
                  alt={`${client.name} logo`}
                  widths={[200, 300]}
                  formats={['avif', 'webp']}
                  loading="lazy"
                  decoding="async"
                  class={`proof-logo ${client.logoInvert ? 'invert' : ''}`}
                />
              </div>
              <p class="proof-type">{client.type}</p>
              <p class="proof-quote">{client.quote}</p>
              <div class="proof-metrics">
                {client.metrics.map((m) => (
                  <div class="proof-row">
                    <span class="proof-label">{m.label}</span>
                    <span class="proof-before">{m.before}</span>
                    <span class="proof-arrow" aria-hidden="true">&rarr;</span>
                    <span class="proof-after">{m.after}</span>
                  </div>
                ))}
              </div>
              <p class="proof-footer">
                <span class="proof-timeline">{client.timeline}</span>
                <span class="proof-pipe">|</span>
                <a href={client.url} target="_blank" rel="noopener noreferrer" class="proof-link">Visit Site &rarr;</a>
              </p>
            </div>
            <div class="proof-right">
              <div class="psi-badge" aria-label={`PageSpeed score ${client.psiScore}`}>
                <svg class="psi-ring" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="52" fill="none" stroke="rgba(255,255,255,0.06)" stroke-width="8" />
                  <circle cx="60" cy="60" r="52" fill="none" stroke="#22c55e" stroke-width="8" stroke-linecap="round" stroke-dasharray="327" stroke-dashoffset={`${327 - (327 * client.psiScore) / 100}`} transform="rotate(-90 60 60)" />
                </svg>
                <div class="psi-inner">
                  <span class="psi-score">{client.psiScore}</span>
                  <span class="psi-label">PageSpeed</span>
                </div>
              </div>
              <div class="speed-stat">
                <span class="speed-value">{client.loadTime}</span>
                <span class="speed-label">load time</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Hook CTA 2 -->
  <section class="hook-cta">
    <div class="section-container hook-cta-inner">
      <p class="hook-cta-headline">Real results. Real businesses. <span class="hook-cta-accent">Ready for yours?</span></p>
      <p class="hook-cta-sub">Same architecture, same performance, same zero monthly cost.</p>
      <a href="#contact" class="btn-primary hook-cta-btn">Let's Talk</a>
    </div>
  </section>

  <!-- Testimonials -->
  <Testimonials />

  <!-- Cost of Inaction -->
  <section id="cost" class="section">
    <div class="section-container">
      <h2 class="section-title">Are These Affecting Your Bottom Line?</h2>
      <p class="section-subtitle">
        These aren't hypotheticals. These are the measurable costs businesses pay every day for outdated systems and manual processes.
      </p>
      <div class="cost-grid">
        <div class="cost-item card">
          <span class="cost-stat">1% sales lost</span>
          <p class="cost-desc">For every 100ms a site takes to load. Slow pages don't just frustrate visitors — they cost real revenue before anyone even sees the product. <a href="https://www.conductor.com/academy/page-speed-resources/faq/amazon-page-speed-study/" target="_blank" rel="noopener" class="cost-cite">Amazon Study</a></p>
        </div>
        <div class="cost-item card">
          <span class="cost-stat">30–60%</span>
          <p class="cost-desc">Cost reduction achieved by operations centers that automate manual, repetitive tasks — while also increasing delivery quality. <a href="https://www.mckinsey.com/capabilities/operations/our-insights/operations-management-reshaped-by-robotic-automation" target="_blank" rel="noopener" class="cost-cite">McKinsey</a></p>
        </div>
        <div class="cost-item card">
          <span class="cost-stat">7x more likely</span>
          <p class="cost-desc">To qualify a lead when the response happens within an hour. The average business takes 42 hours. Automated workflows respond in seconds — around the clock. <a href="https://ainora.lt/blog/lead-response-time-statistics-every-study-2026" target="_blank" rel="noopener" class="cost-cite">HBR Study via AInora</a></p>
        </div>
        <div class="cost-item card">
          <span class="cost-stat">$12.9M/year</span>
          <p class="cost-desc">Average annual cost of poor data quality across organizations. Clean data pipelines and real-time dashboards turn that liability into insight. <a href="https://www.dataversity.net/articles/putting-a-number-on-bad-data/" target="_blank" rel="noopener" class="cost-cite">Gartner via Dataversity</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <Contact
    site={site}
    title='Ready to <span class="text-danger">Stop Losing Money</span> to Bad Tooling?'
    subtitle="Tell me what's not working. I'll tell you how to fix it — no pitch, no pressure."
  />

<script>
  const words = [
    "Attention to detail.",
    "Follow through.",
    "Scalable architecture.",
    "Transparent communication.",
    "Modern frameworks.",
    "Post-launch support.",
    "Continuous integration.",
    "Clean, documented code.",
  ];
  const el = document.querySelector(".rotating-word .rw-text");

  if (el) {
    const startAnimation = () => {
      let wordIndex = 0;
      let charIndex = 0;
      let isDeleting = false;

      const typingSpeed = 70;
      const deletingSpeed = 40;
      const pauseAfterTyped = 1000;

      const typeLoop = () => {
        const currentWord = words[wordIndex];

        if (!isDeleting) {
          charIndex++;
          requestAnimationFrame(() => {
            el.textContent = currentWord.slice(0, charIndex);
          });

          if (charIndex === currentWord.length) {
            isDeleting = true;
            setTimeout(typeLoop, pauseAfterTyped);
            return;
          }

          setTimeout(typeLoop, typingSpeed);
        } else {
          charIndex--;
          requestAnimationFrame(() => {
            el.textContent = currentWord.slice(0, charIndex);
          });

          if (charIndex === 0) {
            isDeleting = false;
            wordIndex = (wordIndex + 1) % words.length;
            setTimeout(typeLoop, 150);
            return;
          }

          setTimeout(typeLoop, deletingSpeed);
        }
      };

      el.textContent = "";
      setTimeout(typeLoop, 400);
    };

    if (typeof requestIdleCallback === "function") {
      requestIdleCallback(startAnimation, { timeout: 2000 });
    } else {
      setTimeout(startAnimation, 200);
    }
  }
</script>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 2.5rem 0 1.5rem;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .hero {
      padding: 5rem 0 2rem;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
  }

  .hero-row {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .hero-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 3.75rem;
    }
  }

  .hero-content {
    flex: 1;
    min-width: 0;
  }

  .hero-wheel {
    display: none;
  }
  @media (min-width: 1024px) {
    .hero-wheel {
      display: flex;
      flex-shrink: 0;
      align-items: center;
      justify-content: center;
      min-height: 500px;
    }
  }

  .hero-marquee-mobile {
    position: relative;
    z-index: 1;
    margin-top: 1.5rem;
  }
  @media (min-width: 1024px) {
    .hero-marquee-mobile {
      display: none;
    }
  }

  .hero-title {
    font-size: 2rem;
    font-weight: 500;
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.5rem;
  }
  @media (min-width: 768px) {
    .hero-title { font-size: 3rem; }
  }
  @media (min-width: 1024px) {
    .hero-title { font-size: 4rem; }
  }

  .hero-rotating {
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 1.25rem;
  }
  @media (min-width: 768px) {
    .hero-rotating { font-size: 1.75rem; }
  }
  @media (min-width: 1024px) {
    .hero-rotating { font-size: 2.25rem; }
  }

  .rotating-word {
    display: inline-block;
    line-height: 1;
    vertical-align: baseline;
  }

  .rw-text {
    display: inline-block;
    color: var(--color-accent-light);
    border-right: 2px solid var(--color-accent-light);
    padding-right: 4px;
    white-space: nowrap;
    animation: hero-cursor-blink 0.8s steps(1, end) infinite;
  }

  @keyframes hero-cursor-blink {
    0%, 49% {
      border-right-color: var(--color-accent-light);
    }
    50%, 100% {
      border-right-color: transparent;
    }
  }

  @media (max-width: 767px) {
    .rotating-word {
      position: relative;
    }

    .rotating-word::before {
      content: "Transparent communication.";
      visibility: hidden;
      white-space: nowrap;
      padding-right: 4px;
    }

    .rw-text {
      position: absolute;
      left: 0;
      top: 0;
    }
  }

  .hero-points {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem 1.5rem;
  }
  @media (min-width: 768px) {
    .hero-points {
      gap: 1rem 2.5rem;
    }
  }
  @media (min-width: 768px) and (max-width: 1023px) {
    .hero-points {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hero-points li {
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }

  .hero-icon {
    font-size: 2.25rem;
    flex-shrink: 0;
  }

  .hero-icon-speed {
    width: 2.25rem;
    height: 2.25rem;
  }

  @media (min-width: 768px) {
    .hero-points li { font-size: 1.125rem; }
  }

  .hero-closer {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .hero-closer {
      font-size: 1.125rem;
      margin-bottom: 2.5rem;
    }
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* ── Sections ── */
  .section {
    position: relative;
    padding: 3rem 0;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .section {
      padding: 4.5rem 0;
    }
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-text);
    margin-bottom: 0.75rem;
  }
  @media (min-width: 768px) {
    .section-title { font-size: 2.25rem; }
  }
  @media (min-width: 1024px) {
    .section-title { font-size: 3rem; }
  }

  .section-subtitle {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    max-width: 600px;
    margin-bottom: 2rem;
  }
  @media (min-width: 768px) {
    .section-subtitle {
      font-size: 1.125rem;
      margin-bottom: 3rem;
    }
  }

  /* ── Services Grid ── */
  .services-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .services-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.25rem;
    }
  }
  @media (min-width: 1024px) {
    .services-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

